<Project Sdk="Microsoft.NET.Sdk">

  <!-- Business logic of the HDT plugin. netstandard2.0 so that both the net48
       plugin and the net8.0 tests can reference it; no HDT or WPF dependency. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same version as the one Hearthstone Deck Tracker ships and loads. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
