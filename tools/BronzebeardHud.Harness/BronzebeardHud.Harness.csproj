<Project Sdk="Microsoft.NET.Sdk">

  <!-- Simulation of the plugin's panels in a plain Windows window, so that they can be moved, resized and looked
       at without Hearthstone running. The REAL panel sources are compiled in (Compile Include, below): PanelMover,
       CompsPanel, GuideView, GuidePopup, TavernMarkers, SkipCombatPanel, ChoiceAdvicePanel, CardImages, PreviewPlacer, OverlayLayer, OverlayClickable.
       ChoiceAdvicePanel is given a stats cache whose fetcher refuses the network (NoNetwork, HarnessWindow.cs): the harness
       never polls it, and hands ChoiceAdvisor synthetic trinket stats instead.
       What they ask of HDT (OverlayExtensions, Log, Database, the asset downloaders) is answered by HdtShim.cs, so
       the harness needs no HDT assembly and does not depend on HDT's version. What HDT's overlay window does around
       them (click-through above the game, hover polled by a probe every 16 ms) is reproduced by HdtOverlay.cs on an
       injected mouse (the "mouse" option and the self-test's "mouse" checks), from HDT 1.58.9 decompiled; WPF's own events
       there are a deduced model.
       Written in C# without XAML, as the plugin, so that it builds under WSL. Not part of BronzebeardHud.sln. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BronzebeardHud.Harness</AssemblyName>
    <RootNamespace>BronzebeardHud.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-only: .NET Framework reference assemblies, so net48 compiles without Windows. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <ProjectReference Include="..\..\src\BronzebeardHud.Stats\BronzebeardHud.Stats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\PanelMover.cs" Link="Plugin\PanelMover.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\CompsPanel.cs" Link="Plugin\CompsPanel.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\BoardPowerView.cs" Link="Plugin\BoardPowerView.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\GuideView.cs" Link="Plugin\GuideView.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\GuidePopup.cs" Link="Plugin\GuidePopup.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\TavernMarkers.cs" Link="Plugin\TavernMarkers.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\SkipCombatPanel.cs" Link="Plugin\SkipCombatPanel.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\ChoiceAdvicePanel.cs" Link="Plugin\ChoiceAdvicePanel.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\CardImages.cs" Link="Plugin\CardImages.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\PreviewPlacer.cs" Link="Plugin\PreviewPlacer.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\OverlayLayer.cs" Link="Plugin\OverlayLayer.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\OverlayClickable.cs" Link="Plugin\OverlayClickable.cs" />
    <Compile Include="..\..\src\BronzebeardHud.HdtPlugin\HeroPickPanel.cs" Link="Plugin\HeroPickPanel.cs" />
    <!-- The zones a default panel must not cover, drawn under the panels: one definition, the tests' one. -->
    <Compile Include="..\..\tests\BronzebeardHud.Stats.Tests\NoGoZones.cs" Link="Plugin\NoGoZones.cs" />
  </ItemGroup>

</Project>
