<Project Sdk="Microsoft.NET.Sdk">

  <!-- Inspection of the local stats cache (chantier b, docs/plans/2026-10-08-chantier-b-socle-plan.md, step 8): reads the
       files the plugin cached, never the network, and prints what the consolidation makes of them, so that its thresholds
       are set on measurements. It writes nothing: its output goes to the console, to be kept outside the repository (no
       real data in a public repository). Not part of BronzebeardHud.sln, like the harness; the CI builds it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BronzebeardHud.Inspect</AssemblyName>
    <RootNamespace>BronzebeardHud.Inspect</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BronzebeardHud.Stats\BronzebeardHud.Stats.csproj" />
  </ItemGroup>

</Project>
