<Project>

  <!-- CI builds with -warnaserror: the code has no warning, and a new one fails the build. Security advisories on
       packages (NU190x) stay visible but do not break a build on a day nothing changed. -->
  <!-- The plugin's version, the one HDT shows and the one tools/release.sh tags (v<Version>): change it here only. -->
  <PropertyGroup>
    <Version>0.4.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
